{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "noEmitOnError": false,
    "lib": ["ES2020", "DOM"],
    "outDir": "./js",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "js/three.js"]
}

